# Copiá a /etc/nginx/sites-available/midulcecata y ajustá server_name.
# Después: sudo ln -s /etc/nginx/sites-available/midulcecata /etc/nginx/sites-enabled/
#          sudo nginx -t && sudo systemctl reload nginx
# SSL: sudo certbot --nginx -d midulcecata.com -d www.midulcecata.com

upstream midulcecata_node {
    server 127.0.0.1:4000;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name midulcecata.com www.midulcecata.com;

    client_max_body_size 6M;

    location / {
        proxy_pass http://midulcecata_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
    }
}
