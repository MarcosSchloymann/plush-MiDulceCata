generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id        String         @id @default(cuid())
  slug      String         @unique
  title     String
  subtitle  String         @default("")
  shortDesc String         @default("")
  fullDesc  String         @default("")
  category  String         @default("chocolates")
  sortOrder Int            @default(0)
  published Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  images    ProductImage[]

  @@index([published, sortOrder])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  filename  String
  alt       String  @default("")
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String   @default("")
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id              String   @id @default("default")
  metaTitle       String
  metaDescription String
  brandName       String
  brandScript     String
  heroEyebrow     String
  heroTitle       String
  heroSubtitle    String
  heroImage           String @default("")
  heroImageMobile     String @default("")
  heroImage2          String @default("")
  heroImageMobile2    String @default("")
  heroIntervalSeconds Int    @default(10)
  logoHeader          String @default("")
  logoFooter      String   @default("")
  bodyBgImage     String   @default("")
  bgColor         String
  primaryColor    String
  secondaryColor  String
  textColor       String
  feature1        String
  feature2        String
  feature3        String
  feature1Image   String   @default("")
  feature2Image   String   @default("")
  feature3Image   String   @default("")
  midBannerImage       String @default("")
  midBannerImageMobile String @default("")
  promo1Title          String
  promo1Image     String   @default("")
  promo2Title     String
  promo2Image     String   @default("")
  ctaLabel        String
  footerIntro     String
  footerColumns   String
  updatedAt       DateTime @updatedAt
}
