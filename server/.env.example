NODE_ENV=development
PORT=4000
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Local con Docker: docker compose up -d
# Luego usá esta URL (o la de Neon / Render / Supabase):
DATABASE_URL="postgresql://midulcecata:midulcecata@localhost:5432/midulcecata?schema=public"

# Neon: para la app podés usar el host *-pooler*. En el build de Render,
# migrate cambia solo a la URL directa (sin -pooler). Opcional en Render:
# DIRECT_URL="postgresql://...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Cambiar123!
PUBLIC_URL=http://localhost:4000
COOKIE_SECURE=false

# Cloudinary (recomendado en Render free: el disco de uploads no es persistente)
# Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional; por defecto midulcecata
# CLOUDINARY_FOLDER=midulcecata
