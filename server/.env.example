NODE_ENV=development
PORT=4000
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Local con Docker: docker compose up -d
# Luego usá esta URL (o la de Neon / Render / Supabase):
DATABASE_URL="postgresql://midulcecata:midulcecata@localhost:5432/midulcecata?schema=public"

# Neon: pooler para la app. En Render, migrate usa el host directo (sin -pooler).
# DIRECT_URL="postgresql://...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Cambiar123!
PUBLIC_URL=http://localhost:4000
COOKIE_SECURE=false

# Cloudinary (obligatorio en Render free; recomendado también en VPS/DonWeb)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=midulcecata

# --- Producción DonWeb (VPS) ---
# NODE_ENV=production
# PORT=4000
# PUBLIC_URL=https://tudominio.com
# COOKIE_SECURE=true
# DATABASE_URL=... Neon pooler o Postgres del VPS
# SESSION_SECRET=... 32+ caracteres
# ADMIN_USERNAME / ADMIN_PASSWORD solo crean el user si todavía no existe
